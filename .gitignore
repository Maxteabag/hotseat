.DS_Store

# Never commit credential material. Nothing here should ever exist in the repo,
# but these patterns make an accident loud instead of silent.
*credentials*.json
.credentials.json
*.pem
*.key
.env

# Locally built binary
/bin/

# Local account/session state must never enter the public repository.
auth.json
oauthAccount.json
.claude/
.codex/
.claude-accounts/
browser-profiles/
*.sqlite
*.sqlite-wal
*.sqlite-shm
.cache/
dist/
